# ---- Meta developer app (ONE-TIME setup by the server owner, see README step 1) ----
# Enables the "Continue with Instagram" one-click login for all users.
FB_APP_ID=your_meta_app_id
APP_SECRET=your_meta_app_secret

# ---- Public URL of this server (needed for OAuth + webhooks) ----
# e.g. https://your-app.onrender.com or https://xxxx.ngrok.io
WEBHOOK_BASE_URL=http://localhost:5000

# Optional: override the OAuth redirect URI (must match Meta app settings exactly).
# Default is {WEBHOOK_BASE_URL}/api/oauth/callback
# OAUTH_REDIRECT_URI=https://your-app.onrender.com/api/oauth/callback

# ---- Webhook verify token (you choose this; enter the same value in Meta dashboard) ----
WEBHOOK_VERIFY_TOKEN=choose_any_random_string_you_like

# ---- Manual-connect fallback only (NOT needed when OAuth is configured) ----
# IG_USER_ID=
# IG_ACCESS_TOKEN=
